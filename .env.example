# ---- Database -------------------------------------------------------------
DATABASE_URL=postgres://tracker:tracker@localhost:5433/media_tracker

# ---- Auth.js --------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Only members of this Discord guild may sign in (verified at every login).
DISCORD_GUILD_ID=

# ---- Discord output -------------------------------------------------------
