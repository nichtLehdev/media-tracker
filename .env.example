# Shared secret for the existing community bot -> tracker REST surface (S6.4)
BOT_API_TOKEN=

# ---- TMDB -----------------------------------------------------------------
TMDB_API_KEY=

# ---- Secrets --------------------------------------------------------------
# 32-byte base64; AES-256-GCM for stored Seerr API keys
# openssl rand -base64 32
SECRETS_ENC_KEY=

# ---- Seerr defaults (S13) -------------------------------------------------
DEFAULT_SEERR_BASE_URL=
DEFAULT_SEERR_API_KEY=

# ---- Public -------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000
